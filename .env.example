# Core
# NOTE: placeholder values only - never commit real secrets. Generate a strong
# random DJANGO_SECRET_KEY for production.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
# Separate secret used to authenticate the audit hash chain in production.
AUDIT_HMAC_SECRET=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Put the active key first; retain previous keys after commas during rotation.
MFA_ENCRYPTION_KEYS=

# Gunicorn (production)
GUNICORN_WORKERS=3
FRONTEND_PORT=8080
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2

# Database
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Production-only operations secrets/configuration
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
BACKUP_ENCRYPTION_KEY=
BACKUP_EXTERNAL_URI=s3://replace-with-approved-encrypted-backup-bucket/platform/
BACKUP_EXTERNAL_KEY_ID=primary
BACKUP_EXTERNAL_KEYS={"primary":"replace-with-base64-32-byte-key"}
BACKUP_EXTERNAL_REGION=
BACKUP_EXTERNAL_ENDPOINT=
BACKUP_EXTERNAL_SSE=AES256
BACKUP_EXTERNAL_KMS_KEY_ID=
BACKUP_EXTERNAL_RETENTION_DAYS=30

# Optional restore target override. Empty uses the isolated SQLite restore target.
BACKUP_RESTORE_DB_ENGINE=
BACKUP_RESTORE_DB_NAME=mhami_restore
BACKUP_RESTORE_DB_USER=
BACKUP_RESTORE_DB_PASSWORD=
BACKUP_RESTORE_DB_HOST=127.0.0.1
BACKUP_RESTORE_DB_PORT=5432

# Optional OpenAI-compatible AI provider. Keep empty for the local fake provider.
AI_PROVIDER_API_KEY=
AI_PROVIDER_ALLOWED_ENDPOINTS=api.openai.com
AI_PROVIDER_TIMEOUT_SECONDS=15
