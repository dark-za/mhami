# Core
# NOTE: placeholder values only - never commit real secrets. Generate a strong
# random DJANGO_SECRET_KEY for production.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
# Separate secret used to authenticate the audit hash chain in production.
AUDIT_HMAC_SECRET=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Required only when the browser UI is hosted on a different origin than Django.
# The production Nginx deployment is same-origin; add its exact HTTPS origin if split.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Required only for the one-time browser setup screen on a new installation.
# Generate a unique value and keep it only with the server operator.
INITIAL_SETUP_TOKEN=change-me
# Gunicorn (production)
GUNICORN_WORKERS=3
FRONTEND_PORT=8080
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2

# Database
POSTGRES_DB=platform
POSTGRES_USER=platform
# Use a unique, high-entropy value outside local throwaway development.
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
# Required by compose.yml (redis-server --requirepass). Use a long random value.
REDIS_PASSWORD=change-me
# Leave these empty to inherit password-aware defaults from compose.yml.
REDIS_URL=
CACHE_URL=
CELERY_RESULT_BACKEND=

# Production-only operations secrets/configuration
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
# Required by compose.prod.yml (must be a valid Fernet key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=C4abnBUZqDUkPjbDDdUQH270tIgV8bs7o47zI3ZtZDQ=
BACKUP_EXTERNAL_URI=
BACKUP_EXTERNAL_KEY_ID=
BACKUP_EXTERNAL_KEYS=
BACKUP_EXTERNAL_REGION=
BACKUP_EXTERNAL_ENDPOINT=
BACKUP_EXTERNAL_SSE=AES256
BACKUP_EXTERNAL_KMS_KEY_ID=
BACKUP_EXTERNAL_RETENTION_DAYS=30

# Optional restore target override. Empty uses the isolated SQLite restore target.
BACKUP_RESTORE_DB_ENGINE=
BACKUP_RESTORE_DB_NAME=mhami_restore
BACKUP_RESTORE_DB_USER=
BACKUP_RESTORE_DB_PASSWORD=
BACKUP_RESTORE_DB_HOST=127.0.0.1
BACKUP_RESTORE_DB_PORT=5432

# Optional OpenAI-compatible AI provider. Keep empty for the local fake provider.
AI_PROVIDER_API_KEY=
AI_PROVIDER_ALLOWED_ENDPOINTS=api.openai.com
AI_PROVIDER_TIMEOUT_SECONDS=15

# Optional Let's Encrypt (compose.prod.yml --profile certbot).
LETSENCRYPT_EMAIL=
LETSENCRYPT_DOMAIN=

# Optional monitoring stack (infra/monitoring/compose.monitoring.yml --profile monitoring).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
