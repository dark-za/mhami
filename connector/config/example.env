# H-04: connector configuration. Copy to .env and set the values.
# The platform refuses to start without these.

# Shared secret with the Mhami platform. The platform issues this
# value out-of-band; rotation is described in the connector contract.
CONNECTOR_API_KEY=replace-with-shared-secret

# Outbound AI provider URL inside the tenant network. The connector
# only forwards to this host; any other destination is rejected.
TENANT_AI_ENDPOINT=http://127.0.0.1:8000

# Maximum time to wait for the tenant's AI provider to respond.
CONNECTOR_OUTBOUND_TIMEOUT=30

# Maximum age of a signed request in seconds.
CONNECTOR_FRESHNESS_SECONDS=300

# Log level. JSON output is emitted on stdout.
CONNECTOR_LOG_LEVEL=INFO
