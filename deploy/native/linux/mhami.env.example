DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_ALLOWED_HOSTS=mhami.example.com
AUDIT_HMAC_SECRET=replace-with-independent-secret
MCP_INTERNAL_HMAC_SECRET=replace-with-independent-secret
MFA_ENCRYPTION_KEYS=replace-with-fernet-key
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
MEDIA_ROOT=/var/lib/mhami/media
BACKUP_STORAGE_ROOT=/var/lib/mhami/backups
BACKUP_RESTORE_ROOT=/var/lib/mhami/backup-restores
GUNICORN_WORKERS=3
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2
